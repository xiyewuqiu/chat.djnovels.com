[Unit]
Description=djnovels IM business layer (JuggleChat server)
Documentation=https://github.com/juggleim/jugglechat-server
After=network-online.target mysql.service mariadb.service mysqld.service djnovels-im-server.service
Wants=network-online.target djnovels-im-server.service

[Service]
Type=simple
User=imapp
Group=imapp
# 业务层把配置路径写死为相对路径 conf/config.yml，这个工作目录不能改。
WorkingDirectory=/opt/djnovels-im/appserver
ExecStart=/opt/djnovels-im/bin/appserver
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=30

LimitNOFILE=65536

Environment=TZ=Asia/Shanghai

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes

[Install]
WantedBy=multi-user.target
