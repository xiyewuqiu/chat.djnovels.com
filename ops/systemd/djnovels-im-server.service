[Unit]
Description=djnovels IM engine (JuggleIM)
Documentation=https://github.com/juggleim/im-server
# After= 里的未知单元会被 systemd 忽略，因此这里同时列出各发行版的 MySQL 服务名。
After=network-online.target mysql.service mariadb.service mysqld.service
Wants=network-online.target

[Service]
Type=simple
User=imapp
Group=imapp
WorkingDirectory=/opt/djnovels-im/im-server
ExecStart=/opt/djnovels-im/bin/imserver -config /opt/djnovels-im/im-server/conf/config.yml
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=30

# 长连接服务的关键参数：默认 1024 个 fd 只够几百个连接。
LimitNOFILE=1048576

Environment=TZ=Asia/Shanghai

# 加固：只允许写 /opt/djnovels-im 与 /tmp
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes

[Install]
WantedBy=multi-user.target
